{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectOnlyAsItsOwnRegisteredThing",
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:*:*:client/${iot:Connection.Thing.ThingName}",
      "Condition": {
        "Bool": { "iot:Connection.Thing.IsAttached": "true" }
      }
    },
    {
      "Sid": "PublishOnlyToItsOwnTopics",
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": [
        "arn:aws:iot:*:*:topic/drishti/robots/${iot:Connection.Thing.ThingName}/telemetry",
        "arn:aws:iot:*:*:topic/drishti/robots/${iot:Connection.Thing.ThingName}/captures"
      ]
    }
  ]
}
